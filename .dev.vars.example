# Copy to .dev.vars for local development (never commit .dev.vars).
# Generate a distinct value for EACH secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SETTINGS_ENC_KEY MUST decode to exactly 32 bytes; replace the placeholder below.
PASSWORD_PEPPER=change-me-local-dev-pepper-at-least-32-bytes
SETTINGS_ENC_KEY=change-me-local-dev-settings-key-32-bytes
