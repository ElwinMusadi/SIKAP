{
  "name": "sikap",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "SIKAP — Sistem Informasi Kepegawaian dan Arsip Pegawai (Cloudflare Pages + D1 + R2)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --local --port 8788 -- vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev dist --local --port 8788",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:web && npm run test:migrate && npm run test:staging && npm run test:import",
    "test:staging": "node --test scripts/staging/*.test.mjs",
    "test:import": "node --test --test-concurrency=1 scripts/import/*.test.mjs",
    "staging:access:audit": "node scripts/staging/access-audit.mjs",
    "staging:target:check": "node scripts/staging/uat-target.mjs",
    "staging:fixture:prepare": "node scripts/staging/uat-fixture.mjs",
    "staging:documents:prepare": "node scripts/staging/uat-document-kit.mjs",
    "staging:remote:preflight": "node scripts/staging/uat-remote-preflight.mjs",
    "staging:holding:build": "node scripts/staging/build-holding.mjs",
    "staging:app:build": "npm run build && node scripts/staging/build-uat-app.mjs",
    "staging:app:deploy": "node scripts/staging/deploy-uat-app.mjs",
    "staging:holding:deploy": "node scripts/staging/deploy-holding.mjs",
    "test:migrate": "node --test scripts/migrate/*.test.mjs",
    "migrate:fixture": "node scripts/migrate/fixture.mjs",
    "migrate:prepare:rehearsal": "node scripts/migrate/prepare-rehearsal.mjs",
    "migrate:transform": "node scripts/migrate/transform.mjs",
    "migrate:apply:local": "node scripts/migrate/apply-local.mjs",
    "migrate:reconcile:local": "node scripts/migrate/reconcile.mjs",
    "test:api": "vitest run",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:seed:dev": "node scripts/dev-seed.mjs && wrangler d1 execute DB --local --file .wrangler/dev-seed.sql",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name sikap-v2 --branch feat/cloudflare-migration",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings server/worker-configuration.d.ts",
    "cron:dev": "wrangler dev -c workers/cron/wrangler.toml --test-scheduled",
    "cron:check": "wrangler deploy -c workers/cron/wrangler.toml --env preview --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElwinMusadi/SIKAP.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "miniflare": "5.20261012.0-beta",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.0"
  }
}
