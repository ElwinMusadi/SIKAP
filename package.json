{
  "name": "sikap",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "SIKAP — Sistem Informasi Kepegawaian dan Arsip Pegawai (Cloudflare Pages + D1 + R2)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --local --port 8788 -- vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev dist --local --port 8788",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:web",
    "test:api": "vitest run",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply sikap-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply sikap-db --remote --env preview",
    "db:seed:dev": "node scripts/dev-seed.mjs && wrangler d1 execute sikap-db --local --file .wrangler/dev-seed.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings server/worker-configuration.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElwinMusadi/SIKAP.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.0"
  }
}
